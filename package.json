{
  "name": "@gatewaystack/acp-mcp-server",
  "version": "0.3.0",
  "mcpName": "io.github.davidcrowe/acp-mcp-server",
  "description": "ACP governance MCP server — log and govern every tool call from Claude, ChatGPT, Lovable, and any MCP client",
  "license": "MIT",
  "author": "David Crowe <david@reducibl.com>",
  "homepage": "https://agenticcontrolplane.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/davidcrowe/acp-mcp-server.git"
  },
  "bugs": {
    "url": "https://github.com/davidcrowe/acp-mcp-server/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai-governance",
    "agent-governance",
    "agentic-control-plane",
    "acp"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server/expressServer.d.ts",
      "default": "./dist/server/expressServer.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "acp-mcp-server": "dist/bin/acp-mcp-server.js"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsc",
    "prepack": "npm run clean && npm run build",
    "test": "npm run build && node --test test/",
    "start": "node dist/server/expressServer.js",
    "dev": "npx tsx src/server/expressServer.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@gatewaystack/identifiabl": "^0.0.6",
    "@gatewaystack/request-context": "^0.0.6",
    "express": "^4.19.2",
    "express-rate-limit": "^8.2.1",
    "jose": "^6.1.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
